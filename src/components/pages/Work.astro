---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cta from '../Cta.astro';
import WorkArchive from '../WorkArchive.astro';
import WorkCards from '../WorkCards.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';
import { workStats } from '../../i18n/work';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const w = t.work;
const L = (p: string) => localizePath(p, lang);

const st = workStats(await getCollection('work'));
---
<Base title={w.metaTitle} description={w.metaDesc}>
<section class="phero"><div class="wrap"><div class="crumb"><a href={L('/')}>~</a> / {w.crumb}</div><h1 set:html={w.pheroH1}></h1><p>{w.pheroP}</p></div></section>


<section class="sec pb-0"><div class="wrap"><div class="shead rv"><div class="spec-lab"><span class="b">—</span> {w.featLab}</div><h2 set:html={w.featH2}></h2><p>{w.featP}</p></div>
<WorkCards featuredOnly={true} limit={4} size="lg" />
</div></section>

<section class="sec pb-0"><div class="wrap"><div class="shead rv"><div class="spec-lab"><span class="b">—</span> {w.allLab}</div><h2 set:html={w.allH2}></h2></div></div></section>
<WorkArchive />
<Cta h2={w.ctaH2} p={w.ctaP} sectionClass="sec pt-0" />
</Base>
