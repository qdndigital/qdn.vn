---
import Base from '../../layouts/Base.astro';
import Cta from '../Cta.astro';
import WorkArchive from '../WorkArchive.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const w = t.work;
const L = (p: string) => localizePath(p, lang);
---
<Base title={w.metaTitle} description={w.metaDesc}>
<section class="phero"><div class="wrap"><div class="crumb"><a href={L('/')}>~</a> / {w.crumb}</div><h1 set:html={w.pheroH1}></h1><p>{w.pheroP}</p></div></section>
<WorkArchive />
<Cta h2={w.ctaH2} p={w.ctaP} sectionClass="sec pt-0" />
</Base>
