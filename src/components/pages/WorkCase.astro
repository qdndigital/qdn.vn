---
/**
 * A single archive record. Spec sheet on the left, the live site framed on the
 * right, then what we actually did — and the next record.
 */
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cta from '../Cta.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';

interface Props {
  entry: CollectionEntry<'work'>;
  prev: { slug: string; brand: string } | null;
  next: { slug: string; brand: string } | null;
}
const { entry, prev, next } = Astro.props;
const d = entry.data;
const { Content } = await entry.render();

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const w = t.work;
const c = t.case;
const L = (p: string) => localizePath(p, lang);

const host = d.url ? d.url.replace(/^https?:\/\//, '').replace(/\/$/, '') : c.internal;
const specs: [string, string][] = [
  [c.specClient, d.client],
  [c.specCountry, d.country],
  [c.specYear, d.year],
  [c.specIndustry, d.industry],
  [c.specPlatform, d.platformLabel],
  [c.specKind, d.kind],
  [c.specRole, d.role],
  [c.specStatus, d.statusLabel],
];
---

<Base title={`${d.brand} — ${c.metaSuffix}`} description={d.summary}>
  <section class="phero">
    <div class="wrap">
      <div class="crumb">
        <a href={L('/')}>~</a> / <a href={L('/work')}>{w.crumb}</a> / {d.rec}
      </div>
      <div class="case-head">
        <div>
          <h1>{d.brand}</h1>
          <p>{d.summary}</p>
        </div>
        <div class="case-actions">
          {d.url && (
            <a href={d.url} class="btn btn-ink" target="_blank" rel="noopener noreferrer">
              {c.visit} <svg viewBox="0 0 24 24"><path d="M7 17L17 7M9 7h8v8" /></svg>
            </a>
          )}
          {d.ownProduct && <a href={L('/products')} class="btn btn-line">{c.ourProduct}</a>}
        </div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap case-grid">
      <div class="case-spec rv">
        <div class="spec-lab"><span class="b">//</span> {c.record}</div>
        <dl>
          {specs.map(([k, v]) => (
            <div class="sr"><dt>{k}</dt><dd>{v}</dd></div>
          ))}
        </dl>
        <div class="case-brief">
          <div class="spec-lab"><span class="b">—</span> {c.challenge}</div>
          <div class="case-prose"><Content /></div>
        </div>
      </div>

      <div class="case-shot rv">
        {d.shot ? (
          <figure class="apwin static">
            <div class="apbar"><i></i><i></i><i></i><b class="apurl">{host}</b></div>
            <img src={d.shot} alt={`${d.brand} — ${d.kind}`} width="1280" height="800" loading="eager" decoding="async" />
          </figure>
        ) : (
          <div class="case-noshot"><span class="spec-lab"><span class="b">—</span> {c.internal}</span><p>{c.noShot}</p></div>
        )}
      </div>
    </div>
  </section>

  <section class="sec pt-0">
    <div class="wrap rv">
      <div class="spec-lab"><span class="b">—</span> {c.whatWeDid}</div>
      <ul class="case-did">
        {d.deliverables.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="sec pt-0">
    <div class="wrap">
      <nav class="case-nav rv">
        {prev ? (
          <a href={L(`/work/${prev.slug}`)} class="cn prev"><span class="k">← {c.prev}</span><span class="v">{prev.brand}</span></a>
        ) : <span></span>}
        <a href={L('/work')} class="cn mid"><span class="k">{c.backLabel}</span><span class="v">{c.back}</span></a>
        {next ? (
          <a href={L(`/work/${next.slug}`)} class="cn next"><span class="k">{c.next} →</span><span class="v">{next.brand}</span></a>
        ) : <span></span>}
      </nav>
    </div>
  </section>

  <Cta h2={w.ctaH2} p={w.ctaP} sectionClass="sec pt-0" />
</Base>
