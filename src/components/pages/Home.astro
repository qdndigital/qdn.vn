---
import Base from '../../layouts/Base.astro';
import HowWeWork from '../HowWeWork.astro';
import Cta from '../Cta.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const h = t.home;
const L = (p: string) => localizePath(p, lang);
// hero example app: 'sales' (shop revenue dashboard) or 'support' (AI support chatbot)
const theme = 'sales' as 'sales' | 'support';
const ex = h.spec[theme];
---
<Base title={h.metaTitle} description={h.metaDesc}>
<!-- HERO -->
<section class="hero"><div class="wrap hero-grid"><div>
<div class="spec-lab"><span class="b">QDN</span> · {h.heroLab} · qdn.vn</div>
<h1 set:html={h.heroH1}></h1>
<p class="lead">{h.heroLead}</p>
<div class="hero-cta"><a href={L('/contact')} class="btn btn-ink">{t.common.startProject} <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a><a href="#how" class="btn btn-line">{t.common.howWeWork}</a></div>
<div class="hero-meta"><div><div class="mono">{h.metaMockup}</div><div class="n">{h.metaMockupN}</div></div><div><div class="mono">{h.metaFaster}</div><div class="n">{h.metaFasterN}</div></div><div><div class="mono">{h.metaShipped}</div><div class="n">{h.metaShippedN}</div></div></div>
</div>
<div class="specimen" id="specimen">
<div class="sp-steps" role="tablist">
{h.spec.steps.map((st, i) => (<>
{i > 0 && <span class="seg" aria-hidden="true"><i></i></span>}
<button type="button" role="tab" class={i === 0 ? 'stp on' : 'stp'} data-k={st.k} data-cap={st.cap} aria-selected={i === 0 ? 'true' : 'false'}><span class="d"></span><span class="nm">{st.name}</span><span class="when">{st.time}</span></button>
</>))}
</div>
<div class="card"><div class="bar"><i></i><i></i><i></i><span class="u">{ex.url}</span><span class="live-b"><span class="live-dot"></span>{h.spec.live}</span></div>
<div class="stage">
<div class="pane p-idea"><div class="brief"><div class="you">{h.spec.you}</div><p class="bt"><span class="tx" data-text={ex.prompt}>{ex.prompt}</span><span class="caret"></span></p><div class="gen"><span class="spin"></span>{h.spec.gen}</div></div></div>
<div class="pane p-screen" aria-hidden="true">
{theme === 'support' && (<div class="scr sup">
<div class="s-head"><span class="s-ava">AI</span><div><div class="s-ttl">{h.spec.support.bot}</div><div class="s-kick">{h.spec.support.status}</div></div></div>
<div class="s-chat">
<div class="m m-q"><span class="bb">{h.spec.support.q}</span></div>
<div class="typing"><span></span><span></span><span></span></div>
<div class="m m-a"><span class="s-ava sm">AI</span><div class="bb"><p>{h.spec.support.a}</p><div class="ord"><span>{h.spec.support.order}</span><span class="pl">{h.spec.support.ship}</span></div></div></div>
<div class="chips">{h.spec.support.chips.map((c) => <span>{c}</span>)}</div>
</div>
<div class="s-in"><span>{h.spec.support.input}</span><span class="snd"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></div>
</div>)}
{theme === 'sales' && (<div class="scr sal">
<div class="kpi"><div><div class="s-kick">{h.spec.sales.kick}</div><div class="num"><span class="roll"><span class="r0">{h.spec.sales.num}</span><span class="r1">{h.spec.sales.num2}</span></span> <span class="dl">{h.spec.sales.delta}</span></div></div><div class="bars">{[38, 52, 44, 61, 55, 72, 80].map((v) => <i style={`--h:${v}%`}></i>)}</div></div>
<div class="s-kick lh">{h.spec.sales.listH} <span class="lh-r"><span class="day">{h.spec.sales.day}</span><span class="rt"><span class="live-dot"></span>{h.spec.sales.rt}</span></span></div>
<ul class="ords"><li class="nw"><span class="oid">{h.spec.sales.fresh.id}</span><span class="who">{h.spec.sales.fresh.who}</span><span class="ago">{h.spec.sales.fresh.ago}</span><span class="amt">{h.spec.sales.fresh.amt}</span><span class={`pl ${h.spec.sales.fresh.k}`}>{h.spec.sales.fresh.st}</span></li>{h.spec.sales.orders.map((o) => <li><span class="oid">{o.id}</span><span class="who">{o.who}</span><span class="amt">{o.amt}</span><span class={`pl ${o.k}`}>{o.st}</span></li>)}</ul>
</div>)}
</div>
</div></div>
<p class="cap" aria-live="polite">{h.spec.steps[0].cap}</p>
</div></div></section>

<!-- PROMISE -->
<section class="sec pb-0"><div class="wrap"><div class="shead ctr rv"><div class="spec-lab justify-center"><span class="b">—</span> {h.promiseLab}</div><h2 class="max-w-2xl mx-auto mt-3.5" set:html={h.promiseH2}></h2></div></div></section>

<!-- WHAT WE BUILD -->
<section class="sec"><div class="wrap"><div class="shead rv"><div class="spec-lab"><span class="b">—</span> {h.buildLab}</div><h2 set:html={h.buildH2}></h2><p>{h.buildP}</p></div>
<div class="proc">
{h.buildCards.map((c) => (
<div class="pc rv"><div class="num">{c.num}</div><h3>{c.h3}</h3><p>{c.p}</p></div>
))}
</div>
<div class="rv mt-9"><a href={L('/services')} class="btn btn-line">{t.common.allServices} <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div></div></section>

<!-- TECH STRIP -->
<section class="sec pt-0"><div class="wrap"><div class="rv border-y border-line py-8 text-center"><div class="spec-lab justify-center mb-4"><span class="b">//</span> {h.techLab}</div><div class="flex flex-wrap justify-center gap-x-6 gap-y-3 font-mono text-sm text-ink-2"><span>React</span><span>Next.js</span><span>Node</span><span>NestJS</span><span>Laravel</span><span>PostgreSQL</span><span>AWS</span><span>OpenAI</span></div></div></div></section>

<!-- HOW WE WORK -->
<HowWeWork howP={h.howP} id="how" sectionClass="sec" />

<!-- PRODUCTS -->
<section class="sec pt-0"><div class="wrap"><div class="shead rv"><div class="spec-lab"><span class="b">—</span> {h.prodLab}</div><h2 set:html={h.prodH2}></h2><p>{h.prodP}</p></div>
<div class="specs">
{h.prodCards.map((c) => (
<div class="sp rv"><div class="top"><span class="id">{c.id}</span><span>{c.status}</span></div><div class="in"><div class="pn">{c.pn}</div><div class="pt">{c.pt}</div><ul>{c.items.map((i) => <li>{i}</li>)}</ul></div></div>
))}
</div><div class="rv mt-8"><a href={L('/products')} class="btn btn-line">{t.common.allProducts} <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div></div></section>

<!-- TESTIMONIALS -->
<section class="sec pt-0"><div class="wrap"><div class="shead ctr rv"><div class="spec-lab justify-center"><span class="b">—</span> {h.tstLab}</div><h2 set:html={h.tstH2}></h2></div><div class="tst">
{h.tst.map((c) => (
<div class="tcard rv"><div class="stars">★★★★★</div><p class="q">{c.q}</p><div class="who"><span class="av">{c.av}</span><div><h3>{c.name}</h3><span>{c.role}</span></div></div></div>
))}
</div></div></section>

<!-- FAQ -->
<section class="sec pt-0"><div class="wrap"><div class="shead ctr rv"><div class="spec-lab justify-center"><span class="b">—</span> {h.faqLab}</div><h2 set:html={h.faqH2}></h2></div><div class="faq rv">
{h.faq.map((f, i) => (
<details open={i === 0}><summary>{f.q}<span class="pm"></span></summary><div class="ans">{f.a}</div></details>
))}
</div></div></section>

<!-- CTA -->
<Cta h2={h.ctaH2} p={h.ctaP} secondaryHref="#how" sectionClass="sec" />
</Base>
