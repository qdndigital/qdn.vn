---
/**
 * The journal is unlinked (not in the nav or footer) and noindexed until there
 * are real posts to publish. The route is kept so it can come back cheaply.
 */
import Base from '../../layouts/Base.astro';
import Cta from '../Cta.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const j = t.journal;
const L = (p: string) => localizePath(p, lang);
---
<Base title={j.metaTitle} description={j.metaDesc} noindex={true}>
<section class="phero"><div class="wrap"><div class="crumb"><a href={L('/')}>~</a> / {j.crumb}</div><h1 set:html={j.pheroH1}></h1><p>{j.pheroP}</p></div></section>
<section class="sec"><div class="wrap"><div class="case-noshot rv"><span class="spec-lab"><span class="b">—</span> {j.crumb}</span><p>{j.empty}</p></div></div></section>
<Cta h2={j.ctaH2} p={j.ctaP} sectionClass="sec pt-0" />
</Base>
